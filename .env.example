# Configuración de la aplicación CitasTaller
# Copiar este archivo a .env y completar los valores reales.
# Nunca subir .env a control de versiones.

FLASK_APP=app
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=cambiar_por_un_valor_seguro_y_aleatorio

# Base de datos local (SQLite en la carpeta instance/)
DATABASE_URL=sqlite:///citas.db

# Llave del agente de IA (pendiente de proveedor)
IA_PROVIDER=simulado
IA_API_KEY=tu_clave_de_api_aqui
IA_MODEL=pendiente

# Credenciales del login de la app (completar en .env, nunca subir valores reales)
APP_USUARIO=
APP_CLAVE=
